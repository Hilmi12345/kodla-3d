  "edgeCases": [
    { "id": "empty-source", "kind": "request", "expectedHttp": 400, "expectedCode": "MODEL_CODE_REQUIRED", "limit": "Boş kaynak worker'a başlatılmaz." },
    { "id": "separate-shells", "kind": "geometry", "mode": "organic", "expectedComponents": 2, "limit": "Ayrı kabuklar raporlanır, otomatik birleştirilmiş katı sayılmaz." },
    { "id": "sub-resolution-sphere", "kind": "resolution-probe", "mode": "organic", "quality": "normal", "expectedHttp": 422, "expectedCode": "GEOMETRY_BUILD_FAILED", "limit": "0.2 mm çap normal SDF örneği yüzey/kapalı hacim üretemeyerek hata verir; minimum özellik boyutu için genel garanti yoktur." },
    { "id": "grid-budget-overflow", "kind": "resolution", "mode": "organic", "quality": "ince", "expectedHttp": 422, "expectedCode": "GEOMETRY_BUILD_FAILED", "limit": "4 milyon hücre sınırı aşılırsa açık hata; kalite sessiz düşürülmez." },
    { "id": "invalid-v2-parameter", "kind": "parameter", "expectedHttp": 400, "expectedCode": "INVALID_REQUEST", "parameterPath": "yanakDolgunlugu", "limit": "V2 şema aralığı dışındaki değer worker'a ulaşmaz." },
    { "id": "worker-crash", "kind": "process", "expectedHttp": 500, "expectedCode": "WORKER_CRASHED", "limit": "Worker kapanır; server yeniden CAD üretebilmelidir. Ayrı lifecycle verifier da bu toparlanmayı test eder." }
  ],
  "notCovered": [
